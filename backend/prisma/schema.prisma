generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  DRIVER
  ADMIN
}

enum OrderStatus {
  OPEN
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum WalletType {
  ADMIN_TOP_UP
  ORDER_EARNING
  ADMIN_ADJUSTMENT
}

model User {
  id             String   @id @default(cuid())
  name           String
  email          String   @unique
  phone          String
  passwordHash   String
  role           Role     @default(CUSTOMER)
  isBlocked      Boolean  @default(false)
  isVerified     Boolean  @default(false)
  driverLicense  String?
  driverFirstNameLatin String?
  driverLastNameLatin String?
  driverPatronymicLatin String?
  driverLicenseSeries String?
  driverLicenseExpiresAt DateTime?
  driverLicenseIssuedAt DateTime?
  driverExperienceMonths Int?
  driverLicenseCategories String[] @default([])
  driverTransmission String @default("AUTOMATIC")
  driverLicenseFront Bytes?
  driverLicenseBack Bytes?
  driverLicenseSelfie Bytes?
  driverDocumentsStatus String @default("NOT_SUBMITTED")
  driverOcrText String?
  dateOfBirth DateTime?
  passportDocumentType String?
  passportNumberEncrypted Bytes?
  passportIssuedByEncrypted Bytes?
  passportIssueDate DateTime?
  passportExpiryDate DateTime?
  passportFront Bytes?
  passportBack Bytes?
  driverProfilePhoto Bytes?
  pendingDriverProfilePhoto Bytes?
  driverProfilePhotoStatus String @default("NONE")
  driverDocumentsPdf Bytes?
  driverVerifiedAt DateTime?
  driverVerificationMessage String?
  rating          Float    @default(5.0)
  balanceAmd     Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  customerOrders Order[]  @relation("CustomerOrders")
  driverOrders   Order[]  @relation("DriverOrders")
  transactions   WalletTransaction[]
  ratingsGiven   Rating[] @relation("RatingsGiven")
  ratingsReceived Rating[] @relation("RatingsReceived")
  skippedOrders SkippedOrder[]
  driverPhotos DriverPhoto[]
  notifications Notification[]
}

model Order {
  id                 String      @id @default(cuid())
  customerId         String
  driverId           String?
  pickupAddress      String
  destinationAddress String
  pickupLat          Float?
  pickupLng          Float?
  destinationLat     Float?
  destinationLng     Float?
  status             OrderStatus @default(OPEN)
  isTest             Boolean     @default(false)
  fareAmd            Int
  requiredLicenseCategory String @default("B")
  transmissionType String @default("AUTOMATIC")
  commissionRate     Int         @default(25)
  commissionAmd      Int         @default(0)
  driverEarningAmd   Int         @default(0)
  note               String?
  createdAt          DateTime    @default(now())
  acceptedAt         DateTime?
  completedAt        DateTime?
  updatedAt          DateTime    @updatedAt

  customer User  @relation("CustomerOrders", fields: [customerId], references: [id])
  driver   User? @relation("DriverOrders", fields: [driverId], references: [id])
  ratings  Rating[]
  skippedBy SkippedOrder[]
  @@index([status, createdAt])
  @@index([driverId, status])
}

model WalletTransaction {
  id             String     @id @default(cuid())
  userId         String
  amountAmd      Int
  type           WalletType
  description    String
  orderId        String?
  createdByAdmin String?
  createdAt      DateTime   @default(now())

  user User @relation(fields: [userId], references: [id])
  @@index([userId, createdAt])
}

model Rating {
  id         String   @id @default(cuid())
  orderId    String
  fromUserId String
  toUserId   String
  score      Int
  comment    String?
  createdAt  DateTime @default(now())

  order    Order @relation(fields: [orderId], references: [id])
  fromUser User  @relation("RatingsGiven", fields: [fromUserId], references: [id])
  toUser   User  @relation("RatingsReceived", fields: [toUserId], references: [id])
  @@unique([orderId, fromUserId])
}


model SkippedOrder {
  id        String   @id @default(cuid())
  orderId   String
  driverId  String
  createdAt DateTime @default(now())

  order  Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  driver User  @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@unique([orderId, driverId])
  @@index([driverId, createdAt])
}


model SiteContent {
 id String @id @default("main")
 content Json
 updatedAt DateTime @updatedAt
}

model DriverPhoto {
 id String @id @default(cuid())
 userId String
 image Bytes
 createdAt DateTime @default(now())
 user User @relation(fields: [userId], references: [id], onDelete: Cascade)
 @@index([userId, createdAt])
}

model Notification {
 id String @id @default(cuid())
 userId String
 title String
 message String
 type String @default("INFO")
 readAt DateTime?
 createdAt DateTime @default(now())
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 @@index([userId,createdAt])
}
